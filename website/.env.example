# Copy to .env.local and fill in. Nothing here is secret — Vite inlines every
# VITE_* value into the client bundle, so never put an API key or a token in
# this file or in .env.local.

# Where the contact form POSTs its JSON enquiry. In production this is
# /contact.php — public/contact.php, copied into dist/ by the build and served
# on the same origin as the page.
#
# Leave it empty locally: there is no PHP in `vite dev`, and the form then
# falls back to opening the visitor's mail client with the enquiry
# pre-written. Any other endpoint that accepts a JSON body would also work.
VITE_CONTACT_ENDPOINT=

# Plausible analytics. Set to the domain as registered in Plausible
# (e.g. zerononsense.in) to load the script; leave empty and no analytics code
# is loaded at all. Plausible sets no cookies and stores no personal data,
# which is why this site carries no consent banner — swapping in a provider
# that does set cookies means adding one.
VITE_ANALYTICS_DOMAIN=
