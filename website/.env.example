# Copy to .env.local and fill in. Nothing here is secret — Vite inlines every
# VITE_* value into the client bundle, so never put an API key or a token in
# this file or in .env.local.

# Where the contact form POSTs its JSON enquiry.
# Any endpoint that accepts a JSON body works: Formspree, Web3Forms, Basin, or
# a function of your own. Leave it empty and the form falls back to opening the
# visitor's mail client with the enquiry pre-written.
VITE_CONTACT_ENDPOINT=

# Plausible analytics. Set to the domain as registered in Plausible
# (e.g. zerononsense.com) to load the script; leave empty and no analytics code
# is loaded at all. Plausible sets no cookies and stores no personal data,
# which is why this site carries no consent banner — swapping in a provider
# that does set cookies means adding one.
VITE_ANALYTICS_DOMAIN=
